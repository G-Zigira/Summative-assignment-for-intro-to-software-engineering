      "startNode": "t1-s1-n1",
      "nodes": [
        {
          "id": "t1-s1-n1",
          "type": "line",
          "speaker": "Narrator",
          "text": "You step into a quiet courtyard. Above the doorway sits a carved bird. Its feet face forward, but its head is turned to look backward.",
          "next": "t1-s1-n2"
        },
        {
          "id": "t1-s1-n2",
          "type": "line",
          "speaker": "Elder",
          "text": "Welcome, traveller. Tell me, why do you think the bird looks back?",
          "next": "t1-s1-d1"
        },
        {
          "id": "t1-s1-d1",
          "type": "decision",
          "prompt": "Why does the bird look back?",
          "options": [
            {
              "id": "a",
              "text": "It is checking for danger.",
              "outcome": "A fair guess. But the carving is telling a different story.",
              "next": "t1-s1-c1"
            },
            {
              "id": "b",
              "text": "To remember what it left behind.",
              "outcome": "Yes. That is exactly the idea behind this symbol.",
              "unlocksCodex": [
                "codex-adinkra"
              ],
              "next": "t1-s1-c1"
            }
          ]
        },
        {
          "id": "t1-s1-c1",
          "type": "context",
          "title": "Sankofa",
          "text": "Sankofa is a word from the Akan language of Ghana. It is often shown as a bird that looks backward while its feet face forward. It carries the idea that we can return to the past to learn what we need for the future.",
          "unlocksCodex": [
            "codex-sankofa"
          ],
          "next": "t1-s1-n3"
        },
        {
          "id": "t1-s1-n3",
          "type": "line",
          "speaker": "Elder",
          "text": "Keep that in mind as we walk on.",
          "next": null
        }
      ],
