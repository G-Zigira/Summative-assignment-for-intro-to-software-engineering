        {
          "id": "t1-s2-n1",
          "type": "line",
          "speaker": "Elder",
          "text": "Look at the wall behind me. Every pattern on it is a symbol with a meaning.",
          "next": "t1-s2-d1"
        },
        {
          "id": "t1-s2-d1",
          "type": "decision",
          "prompt": "What would you like to learn about first?",
