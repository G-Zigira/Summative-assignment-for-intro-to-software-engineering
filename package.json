{
  "name": "sankofa-trails",
  "version": "0.5.0",
  "private": true,
  "description": "Sankofa Trails: a 2D browser game that explores African history and culture.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "node scripts/validate-content.js",
    "validate:content:release": "node scripts/validate-content.js --release",
    "e2e": "playwright test",
    "check": "npm run validate:content && npm test && npm run build",
    "art": "node art-src/build-art.mjs",
    "audio": "python3 audio-src/make_audio.py"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
